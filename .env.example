# ============================================
# MIZAN — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ---- App ----
APP_ENV=development
APP_NAME=MIZAN
APP_DEBUG=true

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=change-me-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://mizan:mizan@localhost:5432/mizan_db

# ---- Firebase ----
# All fields below (except the project ID, which is public) come from
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. That downloads a service-account JSON — copy its fields
# here field-by-field. NEVER commit the JSON file itself (it's gitignored
# via *firebase-adminsdk*.json as an extra safeguard).
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
# Firebase Console → Project Settings → General → Your apps → Web app →
# "Web API Key" (used only if/when the backend calls Identity Toolkit
# REST endpoints directly; not required for Admin SDK token verification).
FIREBASE_WEB_API_KEY=

# ---- AI / LangGraph ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-5
AI_AGENT_TIMEOUT_SECONDS=30

# ---- Notifications ----
FCM_SERVER_KEY=

# ---- Security ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=
